{
  "manifest_version": 3,
  "name": "IAP Auth Demo",
  "version": "0.0.0",
  "description": "Demonstrates a generic, standards-based OAuth client for resources behind an identity-aware proxy.",
  "key": "",
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": ["identity", "storage", "offscreen", "declarativeNetRequestWithHostAccess"],
  "host_permissions": [
    "https://localhost:4010/*",
    "https://localhost:4020/*",
    "https://localhost:4021/*",
    "https://api.example.com/*"
  ]
}
